# Absolute URL of the main Axis site; the "Return to Site" button links here.
# If unset, the button links to "/".
VITE_AXIS_URL=https://axis.example.com

# Base URL of the backend API (e.g. https://api.example.com/v1). If unset, the app uses the
# in-memory mock client. Public configuration only; never put secrets in VITE_* variables.
# VITE_API_URL=

# Mock scenario (dev only; ignored in production builds): normal | loading | empty | error.
# In dev, ?mock=<scenario> in the URL or localStorage key "gr.mock" overrides this.
# VITE_MOCK_SCENARIO=normal
