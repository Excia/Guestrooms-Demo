# Absolute URL of the main Axis site; the "Return to Site" button links here.
# If unset, the button links to "/".
VITE_AXIS_URL=https://axis.example.com

# Base URL of the backend API (e.g. https://api.example.com/v1). Set it and every build uses the
# real client. Public configuration only; never put secrets in VITE_* variables.
# In dev, if unset, the app uses the in-memory mock. In a production build with neither this nor
# VITE_API_MODE=mock set, API calls fail with a "misconfigured" error.
# VITE_API_URL=

# Opt in to the in-memory mock in any build (hosted demo). Ignored when VITE_API_URL is set.
# Builds using the mock outside dev show a "Demo data" chip.
# VITE_API_MODE=mock

# Mock scenario: normal | loading | empty | error. Honoured in dev, and in a build only together
# with VITE_API_MODE=mock. In dev, ?mock=<scenario> or localStorage key "gr.mock" overrides it.
# VITE_MOCK_SCENARIO=normal
